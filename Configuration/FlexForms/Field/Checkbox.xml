<T3DataStructure>
    <ROOT>
        <type>array</type>
        <el>
            <info>
                <TCEforms>
                    <label></label>
                    <config>
                        <type>user</type>
                        <userFunc>Aix\Dataviewer\UserFunc\Template->displayTemplate</userFunc>
                        <parameters>
                            <template>EXT:dataviewer/Resources/Private/Templates/UserFunc/Field/Notice.html</template>
                        </parameters>
                    </config>
                </TCEforms>
            </info>
            <cols>
                <TCEforms>
                    <label>cols</label>
                    <config>
                        <type>input</type>
                        <size>3</size>
                        <eval>int</eval>
                        <default>1</default>
                        <range>
                            <lower>1</lower>
                            <upper>31</upper>
                        </range>
                    </config>
                </TCEforms>
            </cols>
            <readOnly>
                <TCEforms>
                    <label>readOnly</label>
                    <config>
                        <checkbox>1</checkbox>
                        <type>check</type>
                    </config>
                </TCEforms>
            </readOnly>
            <!--
            No need of this
            <maximumRecordsChecked>
                <TCEforms>
                    <label>maximumRecordsChecked</label>
                    <config>
                        <type>input</type>
                        <size>3</size>
                        <eval>int</eval>
                    </config>
                </TCEforms>
            </maximumRecordsChecked>
            -->
        </el>
    </ROOT>
</T3DataStructure>
